# Public URL of this marketing site (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.interviewai.cc
# URL of the InterviewAI app that every "Try now" button opens.
NEXT_PUBLIC_APP_URL=https://www.app.interviewai.cc/

# Contact form delivery via Zoho Mail SMTP (server-only).
# Use an app-specific password from Zoho: Account > Security > App Passwords.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=ashish@interviewai.cc
ZOHO_SMTP_PASS=
# Where contact form messages are delivered.
CONTACT_TO_EMAIL=ashish@interviewai.cc
